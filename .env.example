# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS (SUPABASE / POSTGRESQL)
# Copia este archivo como ".env" y rellena los valores reales
# ¡NUNCA subas el archivo .env a Git!
# ============================================================

# Nombre de la base de datos en Supabase (generalmente "postgres")
DB_NAME=postgres

# Usuario de conexión (en Supabase tiene el formato: postgres.XXXXXXXX)
DB_USER=postgres.upbizktrcukbzaibaopk

# Contraseña que pusiste al crear el proyecto en Supabase
DB_PASSWORD=PerforosVen.01

# Host de la base de datos (en Supabase: db.XXXXXX.supabase.co)
DB_HOST=aws-1-us-east-1.pooler.supabase.com

# Puerto (5432 = directo, 6543 = pooler. Usar 5432 para Django)
DB_PORT=5432
